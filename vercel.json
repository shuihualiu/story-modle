{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/h5/h5/global/:path*",
      "destination": "/h5/global/:path*",
      "permanent": true
    },
    {
      "source": "/company",
      "destination": "/company.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/android/privacy",
      "destination": "/h5/global/global-privacy-policy.html"
    },
    {
      "source": "/android/privacy/",
      "destination": "/h5/global/global-privacy-policy.html"
    },
    {
      "source": "/android/terms",
      "destination": "/h5/global/android-terms-of-use.html"
    },
    {
      "source": "/android/terms/",
      "destination": "/h5/global/android-terms-of-use.html"
    },
    {
      "source": "/privacy",
      "destination": "/h5/global/android-privacy-policy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/h5/global/android-privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/h5/global/global-terms-of-use.html"
    },
    {
      "source": "/terms/",
      "destination": "/h5/global/global-terms-of-use.html"
    },
    {
      "source": "/account-deletion",
      "destination": "/h5/global/global-account-deletion.html"
    },
    {
      "source": "/account-deletion/",
      "destination": "/h5/global/global-account-deletion.html"
    },
    {
      "source": "/company.html",
      "destination": "/h5/global/company.html"
    },
    {
      "source": "/discipline.html",
      "destination": "/h5/global/discipline.html"
    },
    {
      "source": "/flowora-privacy",
      "destination": "/h5/global/flowora-privacy.html"
    },
    {
      "source": "/flowora-privacy/",
      "destination": "/h5/global/flowora-privacy.html"
    },
    {
      "source": "/functions/v1/global-share-og",
      "destination": "/api/global-share-og"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
